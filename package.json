{
  "name": "flare",
  "version": "1.1.0",
  "private": true,
  "description": "Graph-first IDE for agentic coding",
  "author": {
    "name": "AlgoNoRhythm",
    "email": "AlgoNoRhythm@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "serve": "npm run build && node dist-server/index.cjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run build && npm run test && npm run e2e",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "icon": "node scripts/make-icon.mjs",
    "shots": "node scripts/shot-readme.mjs"
  },
  "build": {
    "appId": "dev.flare.app",
    "productName": "Flare",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/**",
      "node_modules/@lydell/**",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "identity": null,
      "notarize": false,
      "artifactName": "${productName}-${version}-macOS-${arch}-beta.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "AlgoNoRhythm <AlgoNoRhythm@users.noreply.github.com>",
      "synopsis": "A desktop IDE for agentic coding",
      "description": "Flare is a graph-first IDE for agentic coding: it maps a repository as a dependency graph, tracks what an agent changes, and exposes the project to assistants over MCP.",
      "syncDesktopName": true,
      "executableName": "flare",
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version} (beta)"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "AlgoNoRhythm",
        "repo": "Flare"
      }
    ],
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "chokidar": "^4.0.3",
    "ignore": "^7.0.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlgoNoRhythm/Flare.git"
  },
  "homepage": "https://github.com/AlgoNoRhythm/Flare",
  "desktopName": "flare.desktop"
}
